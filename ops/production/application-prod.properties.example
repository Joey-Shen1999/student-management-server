# Copy to: /home/ubuntu/student-management-server/application-prod.properties

spring.application.name=student-management-server
spring.main.banner-mode=off

# Backend should only listen on localhost; nginx is the public entrypoint.
server.address=127.0.0.1
server.port=8080

# Datasource credentials come from environment variables loaded by systemd.
spring.datasource.url=${SPRING_DATASOURCE_URL}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=false
spring.flyway.validate-on-migrate=true
spring.flyway.clean-disabled=true

app.cors.allowed-origins=https://globalvip-studentportal.ca,https://www.globalvip-studentportal.ca

# Upload files are private. Use APP_STORAGE_TYPE=s3 in production.env after the EC2 IAM role is attached.
app.storage.type=${APP_STORAGE_TYPE:local}
app.storage.s3.region=${APP_STORAGE_S3_REGION:us-east-2}
app.storage.s3.bucket=${APP_STORAGE_S3_BUCKET:}
app.storage.s3.prefix=${APP_STORAGE_S3_PREFIX:student-management-prod}
