# Copy to: /etc/student-management/env/production.env
# chmod 640 /etc/student-management/env/production.env

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/student_management_prod
SPRING_DATASOURCE_USERNAME=student_app
SPRING_DATASOURCE_PASSWORD=replace-with-strong-password

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@example.com
SPRING_MAIL_PASSWORD=replace-with-mail-password

APP_MAIL_FROM=noreply@example.com
APP_INFO_TASK_EMAIL_REMINDERS_ENABLED=true
APP_TASK_TRACKING_EMAIL_REMINDERS_ENABLED=true

APP_STORAGE_TYPE=s3
APP_STORAGE_S3_REGION=us-east-2
APP_STORAGE_S3_BUCKET=globalvip-studentportal-prod-uploads-680458885427-us-east-2-an
APP_STORAGE_S3_PREFIX=student-management-prod
